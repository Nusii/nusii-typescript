# Copy this file to .env and fill in your credentials. .env is gitignored and
# never published to npm.
#
# Used by the integration tests (npm run test:integration) and by any local
# script: the client reads these automatically when no credentials are passed.

# Personal API token from https://app.nusii.com/settings/api
NUSII_API_KEY=

# Or an OAuth 2.0 access token (used when NUSII_API_KEY is empty)
NUSII_ACCESS_TOKEN=

# Optional: point at another server, e.g. http://localhost:3000
NUSII_BASE_URL=
